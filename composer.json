{
    "name": "osaris-uk/monzo",
    "description": "A full-featured Laravel package for the Monzo Developer API: OAuth with automatic token refresh, accounts, balances, pots, transactions, feed items, attachments, receipts and webhooks.",
    "keywords": ["laravel", "monzo", "banking", "api", "fintech", "open-banking"],
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Osaris",
            "homepage": "https://github.com/osaris-uk"
        }
    ],
    "require": {
        "php": "^8.2",
        "guzzlehttp/guzzle": "^7.8|^8.0",
        "illuminate/console": "^11.0|^12.0|^13.0",
        "illuminate/contracts": "^11.0|^12.0|^13.0",
        "illuminate/http": "^11.0|^12.0|^13.0",
        "illuminate/routing": "^11.0|^12.0|^13.0",
        "illuminate/support": "^11.0|^12.0|^13.0",
        "nesbot/carbon": "^2.72|^3.0"
    },
    "require-dev": {
        "orchestra/testbench": "^9.0|^10.0|^11.0",
        "phpunit/phpunit": "^11.0|^12.0"
    },
    "autoload": {
        "psr-4": {
            "Osaris\\Monzo\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Osaris\\Monzo\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Osaris\\Monzo\\MonzoServiceProvider"
            ],
            "aliases": {
                "Monzo": "Osaris\\Monzo\\Facades\\Monzo"
            }
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
